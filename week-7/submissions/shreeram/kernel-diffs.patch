+uint64
+sys_getthreadinfo(void)
+{
+  uint64 uaddr;
+  struct proc *p = myproc();
+  struct thread_info info;
+
+  argaddr(0, &uaddr);
+  info.pid = p->pid;
+  info.tgid = p->tgid;
+  info.is_thread = p->is_thread;
+  if(copyout(p->pagetable, uaddr, (char *)&info, sizeof(info)) < 0)
+    return -1;
+  return 0;
+}
+
+uint64
+sys_alloc_thread_stack(void)
+{
+  int size;
+  uint64 oldsz, newsz;
+  struct proc *p = myproc();
+
+  argint(0, &size);
+  if(size <= 0)
+    return -1;
+  size = PGROUNDUP(size);
+  oldsz = PGROUNDUP(p->sz);
+  newsz = uvmalloc(p->pagetable, oldsz, oldsz + size, PTE_W);
+  if(newsz == 0)
+    return -1;
+  p->sz = newsz;
+  return newsz;
+}
+
+uint64
+sys_alloc_thread_stack_guarded(void)
+{
+  int size;
+  uint64 oldsz, newsz;
+  struct proc *p = myproc();
+
+  argint(0, &size);
+  if(size <= 0)
+    return -1;
+  size = PGROUNDUP(size);
+  oldsz = PGROUNDUP(p->sz);
+  newsz = uvmalloc(p->pagetable, oldsz, oldsz + PGSIZE + size, PTE_W);
+  if(newsz == 0)
+    return -1;
+  uvmunmap(p->pagetable, oldsz, 1, 1);
+  p->sz = newsz;
+  return newsz;
+}
