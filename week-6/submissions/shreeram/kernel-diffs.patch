+// Week 6, Problem 2: change the priority of the process with the
+// given pid. Returns the OLD priority on success, or -1 if no
+// process with that pid currently exists. Modeled on
+// getprocstatebypid()'s scan-and-lock-one-at-a-time pattern.
+int
+set_priority_bypid(int pid, int prio)
+{
+  struct proc *p;
+  int old;
+
+  if(prio < 0 || prio > 63)
+    return -1;
+
+  for(p = proc; p < &proc[NPROC]; p++){
+    acquire(&p->lock);
+    if(p->pid == pid && p->state != UNUSED){
+      old = p->priority;
+      p->priority = prio;
+      release(&p->lock);
+      return old;
+    }
+    release(&p->lock);
+  }
+  return -1;
+}
+
+// Week 6, Problem 2: read the priority of the process with the given
+// pid, or -1 if no such process currently exists.
+int
+get_priority_bypid(int pid)
+{
+  struct proc *p;
+  int prio;
+
+  for(p = proc; p < &proc[NPROC]; p++){
+    acquire(&p->lock);
+    if(p->pid == pid && p->state != UNUSED){
+      prio = p->priority;
+      release(&p->lock);
+      return prio;
     }
+    release(&p->lock);
   }
+  return -1;
 }
 
