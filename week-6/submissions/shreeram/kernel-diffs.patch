+// Week 6, Problem 2: change the priority of the process with the
+// given pid. Returns the OLD priority on success, -1 if no such
+// process exists. All the table-scanning logic lives in
+// set_priority_bypid() in proc.c, modeled on kill()/getprocstatebypid().
+uint64
+sys_set_priority(void)
+{
+  int pid, prio;
+
+  argint(0, &pid);
+  argint(1, &prio);
+  return set_priority_bypid(pid, prio);
+}
+
+// Week 6, Problem 2: read the priority of the process with the given
+// pid, or -1 if no such process exists.
+uint64
+sys_get_priority(void)
+{
+  int pid;
+
+  argint(0, &pid);
+  return get_priority_bypid(pid);
+}
+
+// Week 6, Problem 3: report whether a given kernel spinlock is
+// currently held. lock_id 0 = tickslock, 1 = the console's cons.lock,
+// anything else is invalid.
+//
+// tickslock is a plain top-level `struct spinlock tickslock;` in
+// kernel/trap.c (NOT kernel/timer.c -- that file doesn't exist in
+// this checkout; see REPORT.md), already extern-declared for us in
+// defs.h, so `tickslock.locked` just works here. cons.lock is a
+// field inside an ANONYMOUS struct instance private to console.c --
+// see the accessor cons_lock_held() added there for why we can't
+// just extern-declare it the way the assignment casually describes.
+uint64
+sys_is_lock_held(void)
+{
+  int lock_id;
+
+  argint(0, &lock_id);
+  if(lock_id == 0)
+    return tickslock.locked;
+  if(lock_id == 1)
+    return cons_lock_held();
+  return -1;
+}
