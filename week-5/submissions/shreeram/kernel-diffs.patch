+// Week 5, Problem 2: return the total number of syscalls the calling
+// process has made since it started. syscall() in syscall.c
+// increments p->syscalls once per call, BEFORE dispatching to the
+// handler -- which means the increment for this very call to
+// getsyscount() has already happened by the time we get here. We
+// chose to make getsyscount() NOT count itself: we report
+// "syscalls before this query," which is the more useful number for
+// a caller trying to count what it did up to some point in its own
+// code, and subtracting 1 here is the only change needed to get
+// that -- see REPORT.md for the reasoning.
+uint64
+sys_getsyscount(void)
+{
+  return myproc()->syscalls - 1;
+}
+
+// Week 5, Problem 3: return the procstate of the process with the
+// given pid, or -1 if no such process currently exists. All the
+// real work -- safely scanning proc[] under each process's own
+// lock -- lives in getprocstatebypid() in proc.c, modeled on kill().
+uint64
+sys_getprocstate(void)
+{
+  int pid;
+
+  argint(0, &pid);
+  return getprocstatebypid(pid);
+}
+
+// Week 5, Problem 4: copy the calling process's name (p->name, set
+// from argv[0] at exec time) into a user-supplied buffer, truncated
+// to fit and NUL-terminated. Returns the number of bytes copied (not
+// counting the NUL), or -1 if max is invalid or a copy fails.
+//
+// p->name lives in KERNEL memory (inside struct proc). buf is a
+// pointer the user program owns, in USER memory, under a different
+// page table -- writing p->name into *buf directly from the kernel
+// would write through whatever physical page happens to be mapped
+// at that virtual address in the KERNEL's page table, which is not
+// the same physical page the user process would see at that
+// address. copyout() is what actually walks the user pagetable to
+// find the right physical page. See REPORT.md for the full
+// explanation of what would go wrong without it.
+uint64
+sys_getcmdline(void)
+{
+  uint64 buf_va;
+  int max;
+  struct proc *p = myproc();
+  int len, n;
+
+  argaddr(0, &buf_va);
+  argint(1, &max);
+
+  if(max <= 0)
+    return -1;
+
+  len = strlen(p->name);
+  n = len < max - 1 ? len : max - 1;   // leave room for the NUL
+
+  if(copyout(p->pagetable, buf_va, p->name, n) < 0)
+    return -1;
+  if(copyout(p->pagetable, buf_va + n, "\0", 1) < 0)
+    return -1;
+
+  return n;
+}
