+// Week 5, Problem 3: look up the current procstate of the process
+// with the given pid. Returns -1 if no process with that pid exists
+// right now. Modeled directly on kill() above: scan the whole
+// proc[] table, acquire/release each individual p->lock (never more
+// than one at a time -- holding two proc locks at once is how you
+// build a deadlock), and never hold a lock longer than needed.
+int
+getprocstatebypid(int pid)
+{
+  struct proc *p;
+  int state;
+
+  for(p = proc; p < &proc[NPROC]; p++){
+    acquire(&p->lock);
+    if(p->pid == pid && p->state != UNUSED){
+      state = p->state;
+      release(&p->lock);
+      return state;
+    }
+    release(&p->lock);
+  }
   return -1;
 }
 
